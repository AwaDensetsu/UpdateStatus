<UserControl x:Class="PlayniteUpdateStatus.UI.LauncherConnectionCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Card">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIf" />
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource HighlightGlyphBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>
    <Border x:Name="ConnectionPanel" BorderBrush="#406F7F94" BorderThickness="1" CornerRadius="7" Padding="18,16">
        <StackPanel>
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right" BorderBrush="#507CBEE4" BorderThickness="1" CornerRadius="3" Padding="7,2" Margin="12,0,0,0"
                    Visibility="{Binding Information.Beta, Converter={StaticResource VisibleIf}}">
                    <TextBlock Text="BETA" FontSize="10" Foreground="#82C5E9" />
                </Border>
                <TextBlock Text="{Binding Information.Heading}" FontWeight="SemiBold" FontSize="16" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusLabel" Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
            <ProgressBar Height="3" IsIndeterminate="True" Margin="0,9,0,0"
                Visibility="{Binding Busy, Converter={StaticResource VisibleIf}}" />
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock x:Name="FolderStatus" Text="{Binding DetectionText}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="FolderPath" Text="{Binding Folder}" ToolTip="{Binding Folder}" FontSize="11" Opacity="0.7"
                        Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Name="FolderButton" Grid.Column="1" Content="{Binding FolderActionText}" Style="{StaticResource CardButton}"
                    IsEnabled="{Binding ActionsAvailable}" Click="FolderClick" VerticalAlignment="Center" />
            </Grid>
            <Border Height="1" Background="#306F7F94" Margin="0,16,0,14" />
            <TextBlock x:Name="DescriptionLabel" Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.9" />
            <Button x:Name="SetupButton" Content="Set up connection" Style="{StaticResource CardButton}" Margin="0,12,0,0"
                IsEnabled="{Binding CanSetup}" Click="SetupClick" Visibility="{Binding ShowSetup, Converter={StaticResource VisibleIf}}" />
            <Button x:Name="RelaunchButton" Content="{Binding RelaunchText}" Style="{StaticResource CardButton}" Margin="0,12,0,0"
                IsEnabled="{Binding CanRelaunch}" Click="RelaunchClick" Visibility="{Binding ShowRelaunch, Converter={StaticResource VisibleIf}}" />
            <Border Background="#107CBEE4" BorderBrush="#207CBEE4" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,14,0,0"
                Visibility="{Binding Information.Beta, Converter={StaticResource VisibleIf}}">
                <StackPanel>
                    <TextBlock Text="Epic observation · Beta" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="Observes supported update activity. Percentages, speed and download controls are unavailable in this beta. Manage downloads in Epic; switching games or closing Playnite leaves them running."
                        TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Expander x:Name="ConnectionDetails" Header="Advanced information &amp; permissions" IsExpanded="False" Margin="0,16,0,0"
                Foreground="{Binding Foreground, ElementName=Card}">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="How it works" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Information.HowItWorks}" TextWrapping="Wrap" Opacity="0.8" Margin="0,5,0,14" />
                    <TextBlock Text="Permissions &amp; security" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Information.Permissions}" TextWrapping="Wrap" Opacity="0.8" Margin="0,5,0,14" />
                    <TextBlock Text="Polling interval (500–2000 ms)" FontWeight="SemiBold" />
                    <ComboBox x:Name="PollingInput" HorizontalAlignment="Left" MinWidth="220" MaxWidth="300" Margin="0,6,0,0"
                        DisplayMemberPath="Label" SelectedValuePath="Milliseconds" SelectionChanged="PollingChanged" IsEnabled="{Binding Enabled}" />
                    <TextBlock Text="Shorter intervals refresh more often and may use more resources. Balanced is the default."
                        TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,5,0,14" />
                    <TextBlock Text="Remove connection" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Information.Removal}" TextWrapping="Wrap" Opacity="0.8" Margin="0,5,0,0" />
                    <Button x:Name="RemoveButton" Content="Remove connection" Style="{StaticResource CardButton}" Margin="0,10,0,0"
                        IsEnabled="{Binding CanRemove}" Click="RemoveClick" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
